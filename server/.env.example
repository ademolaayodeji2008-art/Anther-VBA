# CLIENT_ORIGIN=https://anther-vba.vercel.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="AVIV ERP <your_gmail_address@gmail.com>"
# Must include https:// — used in verification email links
APP_URL=https://anther-vba.vercel.app
