PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/aviv_erp
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
# Comma-separated list of allowed client origins (no trailing slash)
# e.g. for both local dev and Vercel:
# CLIENT_ORIGIN=https://anther-vpr.vercel.app,http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="AVIV ERP <your_gmail_address@gmail.com>"
# Must match the frontend URL — used in verification email links
APP_URL=http://localhost:5173
